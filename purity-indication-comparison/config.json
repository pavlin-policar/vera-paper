{
  "datasets": [
    "iris",
    "penguins",
    "abalone",
    "titanic",
    "attrition",
    "wine_quality",
    "adult",
    "forest_covertype"
  ],
  "plot_variants": [
    {
      "tag": "regular",
      "label": "Regular",

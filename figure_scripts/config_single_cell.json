  "preprocessing": {
    "target_sum": 10000,
    "hvg": {
      "min_mean": 0.0125,
      "max_mean": 3,
      "min_disp": 0.5
    },
    "n_pcs": 50,
    "n_pcs_embedding": 40
  },
  "embeddings": {
    "tsne": {
      "perplexity": 30,
      "random_state": 0
    },
    "umap": {
      "n_neighbors": 10,
      "min_dist": 0.5,
      "random_state": 0
    }
  },
  "explanatory_genes": {
    "selection": "pearson_residuals",
    "n_genes": 500
  },
  "indicators": {
    "threshold": 0,
    "uninformative_max_sample_coverage": 0.8
  },
  "region_defaults": {
    "sample_size": 5000,
    "random_state": 0,
    "merge_min_sample_overlap": 0.8
  },
  "descriptive_defaults": {
    "max_panels": 4,
    "merge_threshold": 0.8,
    "enrich_with_background": true,
    "max_overlap": 0.0
  },
  "descriptor_ranking": "purity_lift",
  "max_descriptors": 5,
  "labels": {
    "max_width": 14,
    "truncation_template": "(+{n})"
  },
  "frame_padding": 0.3
}
